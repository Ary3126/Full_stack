<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Short URL Created</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <main class="page-shell">
        <section class="card">
            <h1>Short URL Created</h1>
            <p class="subtitle">Your short URL is ready to use:</p>
            <div class="result-block">
                <a href="<%= shortUrl %>"><%= shortUrl %></a>
            </div>
            <p class="original-url">Original link: <span><%= redirectUrl %></span></p>
            <a class="button secondary" href="/">Create another short URL</a>
        </section>
    </main>
</body>
</html>
